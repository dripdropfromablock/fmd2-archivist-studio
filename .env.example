# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional local data directory for persistent download archives, queue state, and reading sync.
# The current file-backed stores are designed for a single server instance.
# FMD_DATA_DIR="./.fmd2-data"

# Optional shared HMAC key for signed image-proxy URLs. Set the same random value on all instances.
# IMAGE_PROXY_SIGNING_KEY=""

# The server binds to localhost in development and 0.0.0.0 in production.
# Keep production behind a trusted ingress; set HOST explicitly to override.
# HOST="127.0.0.1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_CLIENT_ID & GITHUB_CLIENT_SECRET: Optional GitHub OAuth App credentials for popup OAuth login.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# GITHUB_TOKEN: Optional GitHub Personal Access Token (with 'repo' scope) for direct server-side release publishing.
GITHUB_TOKEN=""

